<idea-plugin>
    <!-- NOTE: the id is permanent once the plugin is published. -->
    <id>com.codex.desktreadmill</id>
    <name>Treadmill Buddy</name>
    <vendor email="hello@nomikosi.dev" url="https://github.com/nomikosi/Treadmill-Buddy">Nomikosi Consulting</vendor>

    <!-- The single source of the Marketplace description; build.gradle no longer overrides it. -->
    <description><![CDATA[
        <p><b>Treadmill Buddy</b> is a digital stopwatch for developers who walk while they code.</p>
        <p>Track under-desk treadmill sessions from inside any JetBrains IDE with a large digital clock, a status bar widget, a floating movable clock, saved sessions, distance, steps, calories, and goal countdowns.</p>
        <ul>
            <li><b>Marathon:</b> open-ended count-up sessions.</li>
            <li><b>Calorie burn:</b> count down from the time needed to burn a calorie target.</li>
            <li><b>KG burn:</b> count down from the time needed to burn a target mass in kg.</li>
            <li><b>Interval walk:</b> alternating walk/break blocks with a chime at each switch.</li>
        </ul>
        <p>The plugin includes metric and imperial units, selectable calorie algorithms with incline support, optional daily and weekly goals with progress tracking, speed presets, per-speed session breakdowns, personal records, a Settings page for profile/defaults, live speed and incline recalculation, cross-IDE session history with CSV/JSON/TCX export and CSV/JSON import, daily/weekly/all-time totals with a 14-day chart, a six-month activity heatmap, streaks with configurable rest days, move reminders, and configurable auto-pause after inactivity.</p>
        <p>License: Apache License 2.0</p>
    ]]></description>

    <!-- The change notes are rendered from CHANGELOG.md at build time; edit them there. -->

    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.TreadmillBundle</resource-bundle>

    <applicationListeners>
        <listener class="com.codex.desktreadmill.startup.TreadmillActivationListener"
                  topic="com.intellij.openapi.application.ApplicationActivationListener"/>
    </applicationListeners>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
                id="Treadmill Buddy"
                anchor="right"
                icon="/icons/treadmill.svg"
                factoryClass="com.codex.desktreadmill.TreadmillToolWindowFactory"/>
        <!-- Without parentId the platform files the page under Other Settings. -->
        <applicationConfigurable
                parentId="tools"
                id="com.codex.desktreadmill.settings"
                instance="com.codex.desktreadmill.settings.TreadmillConfigurable"
                bundle="messages.TreadmillBundle"
                key="settings.displayName"/>
        <postStartupActivity implementation="com.codex.desktreadmill.startup.TreadmillStartupActivity"/>
        <statusBarWidgetFactory
                id="TreadmillBuddyWidget"
                implementation="com.codex.desktreadmill.ui.TreadmillStatusBarWidgetFactory"/>
        <notificationGroup id="Treadmill Buddy" displayType="BALLOON"/>
    </extensions>

    <actions>
        <group id="TreadmillBuddy.Group" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="TreadmillBuddy.TogglePause"
                    class="com.codex.desktreadmill.actions.TogglePauseAction"
                    icon="AllIcons.Actions.Resume"/>
            <action id="TreadmillBuddy.SaveSession"
                    class="com.codex.desktreadmill.actions.SaveSessionAction"
                    icon="AllIcons.Actions.MenuSaveall"/>
            <action id="TreadmillBuddy.NewSession"
                    class="com.codex.desktreadmill.actions.NewSessionAction"
                    icon="AllIcons.General.Add"/>
            <action id="TreadmillBuddy.KeepRunningWhenIdle"
                    class="com.codex.desktreadmill.actions.ToggleIdlePauseAction"/>
            <action id="TreadmillBuddy.OpenToolWindow"
                    class="com.codex.desktreadmill.actions.OpenToolWindowAction"/>
        </group>
    </actions>
</idea-plugin>
